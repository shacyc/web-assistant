{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate && wrangler d1 migrations apply web-assistant-db --local",
    "db:migrate": "wrangler d1 migrations apply web-assistant-db --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4.20260101.0",
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.59.3"
  }
}
