{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "web-assistant",
	"main": "src/index.ts",
	// Trần là phiên bản workerd mà wrangler đang ghim. Muốn nâng ngày này thì nâng
	// wrangler trước, không thì deploy sẽ từ chối.
	"compatibility_date": "2026-07-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Không để `wrangler deploy` xoá sạch vars/secrets đã set qua dashboard.
	"keep_vars": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	// MỘT cron duy nhất, bắn mỗi 5 phút. Handler `scheduled` trong src/index.ts không
	// hardcode việc gì — nó đọc bảng `schedules` (admin sửa qua /admin/schedules) rồi
	// chạy job nào tới giờ. Đổi giờ chạy = sửa dòng trong DB, KHÔNG deploy.
	// Biểu thức LUÔN theo giờ UTC; giờ trong bảng `schedules` mới theo TIMEZONE.
	// Để cron ở đây (không phải dashboard) vì `wrangler deploy` quản lý cron declarative:
	// cron thêm tay trên dashboard sẽ bị lần deploy sau ghi đè.
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	// Một Worker serve cả SPA lẫn API. `run_worker_first` để /api/* không bị asset
	// handler nuốt mất; mọi path khác rơi về index.html (SPA fallback).
	"assets": {
		"directory": "../web-astryx/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "assistant_db",
			"database_name": "web-assistant-db",
			// Điền sau khi chạy: wrangler d1 create web-assistant-db
			"database_id": "c4dff31f-aba0-4996-856b-14d6fb13110c",
			"migrations_dir": "drizzle"
		},
		{
			"binding": "web_assistant_db",
			"database_name": "web-assistant-db",
			"database_id": "c4dff31f-aba0-4996-856b-14d6fb13110c"
		}
	],
	// Rate limiter dựng sẵn của Workers — không cần thêm hạ tầng.
	// Hai cái bẫy: `period` CHỈ nhận 10 hoặc 60; bộ đếm là per-colo chứ không global,
	// nên con số thực tế có thể cao hơn limit nếu request rải nhiều datacenter.
	"ratelimits": [
		{
			"name": "BOT_LOGIN_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "BOT_RUN_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "ADMIN_LOGIN_LIMITER",
			"namespace_id": "1003",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	// CHỈ những giá trị không phải bí mật. Secret nạp bằng `wrangler secret put`.
	"vars": {
		"TIMEZONE": "Asia/Ho_Chi_Minh",
		"ADMIN_AUTH_MODE": "password"
	}
}